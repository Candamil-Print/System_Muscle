        <button
          type="button"
          class="rounded-xl  dark:bg-[#39BDF8] dark:hover:bg-[#1FA9E8] dark:text-white px-4 py-2 text-sm font-medium text-white transition disabled:opacity-50"
          onclick={handleDelete}
          disabled={loading}
        >
          {#if loading}
            Eliminando...
          {:else}
            Eliminar
          {/if}
        </button>

      </div>

    </div>

  </div>

{/if}
