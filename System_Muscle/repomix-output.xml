    let _ = conn.execute("DELETE FROM productos WHERE nombre = ?1", [nombre]);

    let nuevo = NuevoProducto {
        nombre: nombre.to_string(),
        tipo_producto: "SNACKS".to_string(),
        precio_costo: 5000.0,
