      </div>
      <p class="mt-1 text-sm text-slate-500">{$cart.length} productos</p>
    </div>

    <div class="p-5">

      {#if $cart.length === 0}

        <div
          class="flex flex-col items-center justify-center rounded-xl border border-dashed border-slate-300 dark:border-[#334156] py-10 text-center"
        >
