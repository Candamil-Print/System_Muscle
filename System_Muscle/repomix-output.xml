          (product.precio_sugerido || 0) *
          (product.stock_actual || 0),

        imagen: product.imagen_url || ''
      }));

      await cargarResumenVentas();

    } catch (error) {

      console.error(error);

    } finally {

      loading = false;

    }

    const interval = setInterval(
      cargarResumenVentas,
      5000
    );

    return () => clearInterval(interval);

  });
</script>

