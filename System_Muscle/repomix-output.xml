        stockMax: p.stock_maximo ?? 0,

        status: p.activo ? 'Activo' : 'Inactivo',
        image: p.imagen_url ?? ''
      }));

      console.log('MAPPED =>', mappedProducts);

      products = [...mappedProducts];

    } catch (error) {

