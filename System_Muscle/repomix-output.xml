          <h3 class="text-xl font-bold text-slate-800 dark:text-white">
            {product?.name}
          </h3>

          <span class="mt-2 inline-block rounded-full bg-[#1c5476]/10 dark:bg-[#0C4A6E]/30 text-[#1c5476] dark:text-[#0EA5E9] px-3 py-1 text-xs font-medium">
            {product?.type}
          </span>

        </div>

        <!-- STATS -->
        <div class="grid grid-cols-2 gap-3 rounded-2xl border border-slate-200 dark:border-[#334156] p-4 dark:bg-[#111827]">

          <!-- costo -->
          <div>
            <p class="text-xs text-slate-500 dark:text-[#94A3B8]">
              Precio Costo
            </p>

            <p class="mt-1 text-sm font-semibold text-slate-800 dark:text-white">
