                               OR (m2.fecha = me.fecha AND m2.id_movimiento > me.id_movimiento))
                    ), 0)
                    - me.cantidad AS stock_anterior,
                s.stock_actual
                    - COALESCE((
                        SELECT SUM(m2.cantidad)
                        FROM movimientos_entrada m2
                        WHERE m2.id_producto = me.id_producto
