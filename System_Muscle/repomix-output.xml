					'cerrar_turno',
					{
						idTurno: turnoActivo.id_turno
					}
				);
			}
		}

		localStorage.removeItem('sesion');

		toast.success(
			'Sesión cerrada correctamente'
		);

		await goto('/');

	} catch (error) {
		console.error(
			'Error al cerrar sesión:',
			error
		);

		toast.error(
			'No fue posible cerrar la sesión'
		);
	}
}
