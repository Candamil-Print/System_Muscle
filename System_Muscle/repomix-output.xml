            Err(e) => return Err(e),
        };
        let id_tipo_turno = match row.get(2) {
            Ok(v) => v,
            Err(e) => return Err(e),
        };
        let fecha_inicio = match row.get(3) {
            Ok(v) => v,
            Err(e) => return Err(e),
        };
        let fecha_fin = match row.get(4) {
            Ok(v) => v,
            Err(e) => return Err(e),
        };
        let estado = match row.get(5) {
